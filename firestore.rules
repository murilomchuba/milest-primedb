rules_version = '2';

// MILEST — isolamento entre empresas
//
// Cada empresa é a raiz dos próprios dados: orgs/{orgId}/projects/...
// O acesso a projeto depende de UMA coisa só — ser membro ativo daquela
// empresa. O gestor da plataforma não entra nessa conta: não é que ele seja
// barrado, é que não existe caminho. Isso é proposital e é o que sustenta a
// promessa de que quem opera o MILEST não lê os dados dos clientes.
//
// Prazo: `expiraEm` na empresa corta a ESCRITA quando vence; a leitura fica.
//
// Publicar com:  firebase deploy --only firestore:rules
// (o projeto vem do .firebaserc; hoje: milest-app)

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function eu() { return request.auth.token.email.lower(); }

    // A conta dona é sempre gestora da plataforma, mesmo que o banco esteja
    // vazio ou que o cadastro dela ainda não tenha a marca. Sem isso existe um
    // impasse: para gravar a marca seria preciso já tê-la.
    function contaDona() { return logado() && eu() == 'mmc.chuba@gmail.com'; }

    // ---- índice: em que empresa cada conta está --------------------------
    function meuIndice() { return /databases/$(database)/documents/users/$(eu()); }
    function souPlataforma() {
      return contaDona()
          || (logado() && exists(meuIndice()) && get(meuIndice()).data.plataforma == true);
    }

    // ---- membros de uma empresa ------------------------------------------
    function docMembro(org) { return /databases/$(database)/documents/orgs/$(org)/members/$(eu()); }
    function docOrg(org)    { return /databases/$(database)/documents/orgs/$(org); }

    function orgViva(org) {
      return exists(docOrg(org)) && get(docOrg(org)).data.ativo != false;
    }

    // Prazo de acesso (avaliação ou assinatura). `expiraEm` é a data em
    // milissegundos; ausente ou 0 significa sem prazo. Vencido, a empresa
    // continua LENDO os próprios dados — só para de escrever. É de propósito:
    // quem testou vê o trabalho que fez do outro lado do vidro, e isso vende
    // melhor do que uma porta fechada. Só a plataforma mexe neste campo.
    function orgNoPrazo(org) {
      return get(docOrg(org)).data.get('expiraEm', 0) == 0
          || request.time.toMillis() < get(docOrg(org)).data.expiraEm;
    }
    function daOrg(org) {
      return logado() && exists(docMembro(org))
          && get(docMembro(org)).data.ativo != false
          && orgViva(org);
    }
    function papelNa(org) { return get(docMembro(org)).data.papel; }
    function editaOrg(org)  { return daOrg(org) && orgNoPrazo(org) && papelNa(org) in ['admin', 'gerente']; }
    function mandaNaOrg(org) { return daOrg(org) && orgNoPrazo(org) && papelNa(org) == 'admin'; }

    function mexeuSomenteEm(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ---- cadastro das empresas -------------------------------------------
    match /orgs/{org} {
      // a empresa lê o próprio cadastro; a plataforma lê todos (é o painel de gestão)
      allow get: if daOrg(org) || souPlataforma();
      allow list: if souPlataforma();
      allow create, delete: if souPlataforma();

      // a plataforma cuida de plano e situação, mas NÃO pode reabrir a janela
      // de provisionamento depois de fechada — semDono só anda de true para false
      // `propria` é definida no nascimento e nunca muda: sem isso, uma empresa
      // de cliente poderia ser marcada como própria depois e abrir a porta
      allow update: if (souPlataforma()
                        && !(resource.data.semDono == false && request.resource.data.semDono == true)
                        && request.resource.data.get('propria', false) == resource.data.get('propria', false))
                    || (mandaNaOrg(org) && mexeuSomenteEm(['nome', 'cnpj', 'atualizadoEm', 'projetos', 'usuarios']))
                    || (editaOrg(org)   && mexeuSomenteEm(['projetos', 'usuarios', 'atualizadoEm']));

      // ---- quem pertence à empresa ---------------------------------------
      match /members/{email} {
        allow get, list: if daOrg(org) || souPlataforma();

        // A plataforma cadastra UM administrador ao criar a empresa, e só
        // enquanto a empresa ainda não tem dono.
        //
        // Ela NÃO pode cadastrar a si mesma numa empresa de cliente — é o que
        // sustenta a promessa de não alcançar os dados de ninguém. A única
        // exceção é a empresa do próprio operador, que nasce marcada com
        // `propria: true`: a exceção fica gravada no dado, visível a quem
        // auditar, em vez de ser um privilégio invisível.
        allow create: if mandaNaOrg(org)
                      // provisionamento de um cliente: uma única vez, enquanto a
                      // empresa não tem dono, e nunca cadastrando a si mesma
                      || (souPlataforma()
                          && get(docOrg(org)).data.semDono == true
                          && request.resource.data.papel == 'admin'
                          && email.lower() != eu())
                      // a empresa do próprio operador: ele entra nela quando quiser,
                      // inclusive para consertar uma criação que parou no meio
                      || (souPlataforma()
                          && get(docOrg(org)).data.get('propria', false) == true
                          && email.lower() == eu()
                          && request.resource.data.papel == 'admin');

        allow update: if mandaNaOrg(org)
                      || (logado() && eu() == email.lower()
                          && mexeuSomenteEm(['ultimoAcesso', 'senhaProvisoria'])
                          // só para desligar: ninguém se marca como provisório
                          && request.resource.data.get('senhaProvisoria', false) == false);
        allow delete: if mandaNaOrg(org);
      }

      // ---- cronogramas: SÓ membros da empresa ----------------------------
      // (a plataforma não aparece em nenhuma destas linhas, de propósito)
      match /projects/{projeto} {
        allow read: if daOrg(org);
        allow write: if editaOrg(org);
        match /{documento=**} {
          allow read: if daOrg(org);
          allow write: if editaOrg(org);
        }
      }

      // ---- equipe: cadastro único dentro da empresa -----------------------
      match /resources/{recurso} {
        allow read: if daOrg(org);
        allow write: if editaOrg(org);
      }
    }

    // ---- índice de contas -------------------------------------------------
    match /users/{email} {
      allow get: if logado() && (eu() == email.lower() || souPlataforma());
      allow list: if souPlataforma();

      // o administrador de uma empresa aponta a conta para a própria empresa,
      // e nunca pode se conceder o papel de plataforma
      allow create: if souPlataforma()
                    || (mandaNaOrg(request.resource.data.orgId)
                        && request.resource.data.get('plataforma', false) == false);
      allow update: if souPlataforma()
                    || (logado() && eu() == email.lower() && mexeuSomenteEm(['ultimoAcesso']))
                    || (mandaNaOrg(request.resource.data.orgId)
                        && request.resource.data.get('plataforma', false) == false
                        && resource.data.get('plataforma', false) == false
                        && resource.data.get('orgId', request.resource.data.orgId) == request.resource.data.orgId);
      allow delete: if souPlataforma() || mandaNaOrg(resource.data.get('orgId', '—'));
    }

    // ---- estrutura antiga, anterior à separação por empresa ---------------
    // Continua legível apenas para a conta dona, o tempo necessário para a
    // migração. Depois de conferir a cópia, apague estas coleções e este bloco.
    match /projects/{projeto} {
      allow read, write: if contaDona();
      match /{documento=**} { allow read, write: if contaDona(); }
    }
    match /resources/{recurso} {
      allow read, write: if contaDona();
    }

    // Nada mais é acessível.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
